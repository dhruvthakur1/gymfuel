# Leave MONGODB_URI empty in development to use an in-memory database with demo data.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000

# Frontend origin(s), comma separated. The first is used for Stripe redirect URLs.
CLIENT_URL=http://localhost:5173
CURRENCY=inr

# Stripe test keys (https://dashboard.stripe.com/test/apikeys). Leave empty to use simulated payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Seeded account passwords. ADMIN_PASSWORD is required in production to create the real admin.
ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=demoadmin123
DEMO_CUSTOMER_PASSWORD=demo12345
